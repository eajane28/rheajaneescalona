---
interface Props {
  title: string;
  tagline?: string;
  align?: "start" | "center";
  intro?: string;
}

const { align = "center", tagline, title, intro } = Astro.props;
---

<div class:list={["hero stack gap-4", align]}>
  <div class="stack gap-2">
    {intro && <p class="hero-eyebrow">{intro}</p>}
    <h1 class="title">{title}</h1>
    {tagline && <p class="tagline">{tagline}</p>}
  </div>
  <slot />
</div>

<style>
  .hero {
    font-size: var(--text-lg);
    text-align: center;
  }

  .title,
  .tagline {
    margin-inline: auto;
  }

  .title {
    font-size: var(--text-3xxl);
    color: var(--gray-0);
  }
  

  .hero-eyebrow::before {
    content: "";
    display: block;
    width: 28px;
    height: 1px;
    background: var(--violet-lt);
    opacity: 0.6;
  }
  

  @media (min-width: 50em) {
    .hero {
      font-size: var(--text-xl);
    }

    .start {
      text-align: start;
    }

    .start .title,	
    .start .tagline {
      margin-inline: unset;
    }

    .title {
      font-size: var(--text-5xl);
    }
  }
</style>
