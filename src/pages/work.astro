---
import { getCollection } from 'astro:content';
import ContactCTA from '../components/ContactCTA.astro';
import Grid from '../components/Grid.astro';
import Hero from '../components/Hero.astro';
import PortfolioPreview from '../components/PortfolioPreview.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const projects = (await getCollection('work'));
---

<BaseLayout
	title="My Work | Rhea Jane Escalona"
	description="Learn about Rhea Jane Escalona's most recent projects"
>
	<div class="stack gap-20" style="padding-top: 10%;">
		<main class="wrapper stack gap-8">
			<Hero
				title="My Work"
				tagline="See my most recent work experience and projects below to get an idea of my experiences."
				align="start"
			/>
			<Grid variant="offset">
				{
					projects.map((project) => (
						<li>
							<PortfolioPreview project={project} />
						</li>
					))
				}
			</Grid>
		</main>
		<ContactCTA />
	</div>
</BaseLayout>
